# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채워 주세요.
# .env 는 .gitignore 에 들어 있어서 Git 에 올라가지 않습니다.

# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# YouTube Data API v3 키 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보)
YOUTUBE_API_KEY=

# (선택) 내 채널 테스트 영상 링크 (일부 공개). scripts/reset_test_video.py 가 이 영상 기록만 지울 때 씀
TEST_VIDEO_URL=
